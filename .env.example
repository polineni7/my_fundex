# Copy to a private environment file. Never commit populated secrets.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Postgres=Host=postgres;Database=my_fundex;Username=myfundex;Password=REPLACE;SSL Mode=Require
Jwt__Key=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
Cors__Origins__0=https://trader.example.com
Cors__Origins__1=https://admin.example.com
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__TraderOrigin=https://trader.example.com
DataProtection__KeyDirectory=/var/myfundex/keys
DataProtection__CertificatePath=/run/secrets/data-protection.pfx
DataProtection__CertificatePassword=
Razorpay__Mode=Test
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=
Razorpay__CheckoutEnabled=false
Broker__Upstox__Sandbox__AccessToken=
Broker__Upstox__MarketData__AccessToken=
# Broker__Upstox__Accounts__YOUR_CREDENTIAL_REFERENCE__AccessToken=
Messaging__Smtp__Host=
Messaging__Smtp__Port=587
Messaging__Smtp__Sender=
Messaging__Smtp__Username=
Messaging__Smtp__Password=
Database__Migrate=false
Bootstrap__SeedAdmin=false
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=

# Enable only after broker allocation and end-to-end validation.
Trading__LiveEnabled=false
RazorpayX__Enabled=false
RazorpayX__Mode=Test
RazorpayX__KeyId=
RazorpayX__KeySecret=
RazorpayX__AccountNumber=
Workers__Enabled=true
